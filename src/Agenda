/**
 * Agenda.gs — Cálculo de horários livres e backup
 */

function minutos(hhmm) {
  const [h, m] = String(hhmm).split(':').map(Number);
  return h * 60 + (m || 0);
}

function hhmm(min) {
  const h = Math.floor(min / 60), m = min % 60;
  return String(h).padStart(2, '0') + ':' + String(m).padStart(2, '0');
}

function horariosLivres(profissionalId, dataISO, servicoId) {
  const prof = lerAba(ABAS.PROFISSIONAIS).find(p => String(p.id) === String(profissionalId));
  const serv = lerAba(ABAS.SERVICOS).find(s => String(s.id) === String(servicoId));
  if (!prof || !serv) return [];

  const data = new Date(dataISO + 'T00:00:00');
  const dias = String(prof.dias).split(',').map(Number);
  if (!dias.includes(data.getDay())) return [];

  const dur = Number(serv.duracao_min);
  const inicio = minutos(prof.hora_inicio);
  const fim = minutos(prof.hora_fim);
  const passo = Number(getConfig().intervalo_min) || 30;

  const ocupados = lerAba(ABAS.AGENDAMENTOS)
    .filter(a => String(a.profissional_id) === String(profissionalId)
      && String(a.data).slice(0, 10) === dataISO
      && String(a.status).toLowerCase() === STATUS.AGENDADO)
    .map(a => ({ ini: minutos(a.hora_inicio), fim: minutos(a.hora_fim) }));

  const livres = [];
  for (let t = inicio; t + dur <= fim; t += passo) {
    if (!ocupados.some(o => t < o.fim && (t + dur) > o.ini)) livres.push(hhmm(t));
  }
  return livres;
}

function agendaDoDia(data) {
  const iso = Utilities.formatDate(data, Session.getScriptTimeZone(), 'yyyy-MM-dd');
  return lerAba(ABAS.AGENDAMENTOS)
    .filter(a => String(a.data).slice(0, 10) === iso)
    .sort((a, b) => String(a.hora_inicio).localeCompare(String(b.hora_inicio)));
}

function fazerBackup() {
  const ss = SpreadsheetApp.getActive();
  const nome = 'backup-' + Utilities.formatDate(new Date(), Session.getScriptTimeZone(), 'yyyy-MM-dd-HHmm');
  const pastas = DriveApp.getFoldersByName('Backups');
  const pasta = pastas.hasNext() ? pastas.next() : DriveApp.createFolder('Backups');
  DriveApp.getFileById(ss.getId()).makeCopy(nome, pasta);
  return 'Backup criado: ' + nome;
}
